---
import GalleryImage from "../components/GalleryImage.astro";
import data from "../data/data.json";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Galería - Baobabs">
  <section class="galeria container">
    <h1>Galería</h1>
    <div class="galeria-grid">
      {
        data.galeria.map((item) => (
          <GalleryImage
            imageData={item}
            onClick={() => console.log(item.titulo)}
          />
        ))
      }
    </div>
  </section>
  <style>
    .galeria {
      padding: 2rem 0;
      text-align: center;
    }
    .galeria-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
      padding: 1rem;
    }
    h1 {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
      color: #333;
    }
  </style>
</Layout>
