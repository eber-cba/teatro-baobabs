---
// index.astro
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/carousel/Carousel.jsx";
import Card from "../components/Card.astro";
import data from "../data.json";
import Hero from "../components/Hero/Hero";
import EventCard from "../components/EventCard.astro";

interface Taller {
  id: string;
  titulo: string;
  descripcion: string;
  imagen: string;
}

interface Event {
  id: string;
  title: string;
  date: string;
  time: string;
  location: string;
  address: string;
  price: string;
  description: string;
  image: string;
}

interface GaleriaItem {
  id: string;
  titulo: string;
  imagen: string;
}

interface Data {
  talleres: Taller[];
  events: Event[];
  galeria: GaleriaItem[];
}

// Extraemos los datos necesarios
const { talleres, galeria } = data as Data;

// Actualizamos las imágenes de los eventos
const events = (data as Data).events.map((event) => ({
  ...event,
  image:
    event.id === "taller-impro"
      ? "https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?w=800&auto=format&fit=crop&q=60"
      : event.id === "workshop-escritura"
        ? "https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=800&auto=format&fit=crop&q=60"
        : "https://images.unsplash.com/photo-1518834107812-67b0b7c58434?w=800&auto=format&fit=crop&q=60",
}));
---

<Layout title="Baobabs – Inicio">
  <!-- Sección Hero -->
  <section>
    <Hero client:load />
  </section>

  <!-- Sección de Talleres Actuales -->
  <section>
    <Carousel items={talleres} client:only="react" />
  </section>

  <!-- Sección de Próximos Eventos -->
  <section class="events-section">
    <div class="container">
      <h2>Próximos Eventos</h2>
      <div class="events-grid">
        {
          events
            .slice(0, 3)
            .map((event) => (
              <EventCard
                id={event.id}
                title={event.title}
                date={event.date}
                time={event.time}
                location={event.location}
                address={event.address}
                price={event.price}
                description={event.description}
                image={event.image}
              />
            ))
        }
      </div>
      <div class="view-all-container">
        <a href="/eventos" class="view-all-button">Ver todos los eventos</a>
      </div>
    </div>
  </section>

  <!-- Sección de Galería Rápida -->
  <section>
    <h2>Galería Rápida</h2>
    <div class="grid">
      {
        galeria.slice(0, 4).map((img) => (
          <a
            href={`/galeria?id=${img.id}`}
            data-key={img.id}
            style="text-decoration: none; color: inherit;"
          >
            <div class="clickable-gallery">
              <img src={img.imagen} alt={img.titulo} />
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  p {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  h2 {
    font-size: 2.5rem;
    color: #2fb979;
    font-family: "FuturaBold", sans-serif;
    text-align: center;
    margin-bottom: 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .clickable-gallery img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  /* Estilos responsivos */
  @media (max-width: 768px) {
    .grid {
      gap: 0.8rem;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .events-section {
    padding: 80px 0;
    background: #f8f9fa;
  }

  .events-section h2 {
    text-align: center;
    color: #2fb979;
    font-size: 2.5rem;
    margin-bottom: 40px;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }

  .view-all-container {
    text-align: center;
  }

  .view-all-button {
    display: inline-block;
    padding: 15px 30px;
    background: #2fb979;
    color: white;
    text-decoration: none;
    border-radius: 25px;
    font-size: 1.1rem;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }

  .view-all-button:hover {
    background: #248c5f;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .events-section {
      padding: 60px 0;
    }

    .events-section h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .events-section h2 {
      font-size: 1.8rem;
    }

    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Animación para la sección de eventos
  gsap.from(".events-section h2", {
    scrollTrigger: {
      trigger: ".events-section",
      start: "top 80%",
    },
    y: 30,
    opacity: 0,
    duration: 1,
    ease: "power3.out",
  });

  gsap.from(".event-card", {
    scrollTrigger: {
      trigger: ".events-section",
      start: "top 80%",
    },
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "power3.out",
  });

  gsap.from(".view-all-button", {
    scrollTrigger: {
      trigger: ".events-section",
      start: "top 80%",
    },
    y: 20,
    opacity: 0,
    duration: 0.8,
    delay: 0.6,
    ease: "power3.out",
  });
</script>
