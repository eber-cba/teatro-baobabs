---
// index.astro
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/carousel/Carousel.jsx";
import Card from "../components/Card.astro";
import data from "../data/data.json";
import Hero from "../components/Hero/Hero";

// Extraemos los datos necesarios
const { talleres, galeria } = data;
const proximosEncuentros = talleres.slice(0, 3);
---

<Layout title="Baobabs – Inicio">
  <!-- Sección Hero -->
  <section>
    <Hero client:load />
  </section>

  <!-- Sección de Talleres Actuales -->
  <section>
    <Carousel items={talleres} client:only="react" />
  </section>

  <!-- Sección de Próximos Encuentros -->
  <section class="proximos-encuentros">
    <h2>Próximos Encuentros</h2>
    <div class="grid">
      {
        proximosEncuentros.map((taller) => (
          <div class="clickable-card" data-info={JSON.stringify(taller)}>
            <Card item={taller} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Sección de Galería Rápida -->
  <section>
    <h2>Galería Rápida</h2>
    <div class="grid">
      {
        galeria.slice(0, 4).map((img) => (
          <a
            href={`/galeria?id=${img.id}`}
            data-key={img.id}
            style="text-decoration: none; color: inherit;"
          >
            <div class="clickable-gallery">
              <img src={img.imagen} alt={img.titulo} />
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <style>
    h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
    }
    p {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
    h2 {
      font-size: 2.5rem;
      color: #2fb979;
      font-family: "FuturaBold", sans-serif;
      text-align: center;
      margin-bottom: 1rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .clickable-card {
      cursor: pointer;
    }
    .clickable-gallery img {
      width: 100%;
      height: auto;
      border-radius: 8px;
    }
    /* Estilos responsivos */
    @media (max-width: 768px) {
      .grid {
        gap: 0.8rem;
      }
    }
    @media (max-width: 480px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
