---
const { title = "Baobabs - Taller de Teatro" } = Astro.props;
import NavBar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        /* Nueva paleta de colores */
        --color-primario: #432e54; /* Header y elementos principales */
        --color-secundario: #4b4376; /* Para botones, enlaces o detalles */
        --color-accent: #ae445a; /* Color de acento */
        --color-fondo: #e8bcb9; /* Fondo general */
        --color-texto: #432e54; /* Color del texto principal */
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(
          135deg,
          #ae445a,
          #6c5ce7
        ); /* Fondo degradado */
        color: var(--color-texto);
      }

      header {
        background: var(--color-primario);
        padding: 1rem;
        text-align: center;
      }

      /* El título en el header con un color claro para contraste */
      header h1 {
        color: #e8bcb9;
        margin: 0;
      }

      main {
        padding: 2rem;
      }

      /* Puedes usar el color secundario en enlaces o botones si quieres */
      a {
        color: var(--color-secundario);
        text-decoration: none;
      }

      /* Responsivo */
      @media (max-width: 768px) {
        main {
          padding: 1.5rem;
        }
      }
      @media (max-width: 480px) {
        main {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Baobabs</h1>
      <NavBar />
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
