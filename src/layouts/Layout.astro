---
const { title = "Baobabs - Taller de Teatro" } = Astro.props;
import NavBar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      :root {
        /* Nueva paleta de colores */
        --color-primario: #2fb979; /* Header y elementos principales */
        --color-secundario: #e672ae; /* Para botones, enlaces o detalles */

        --color-texto: #2fb979; /* Color del texto principal */
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        margin: 0;
        color: var(--color-texto);
        font-family: "FuturaBook", sans-serif;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "FuturaRound", sans-serif;
      }

      .title-emphasis {
        font-family: "FuturaBold", sans-serif;
      }

      .subtitle-text {
        font-family: "FuturaRoundDemi", sans-serif;
      }

      /* El título en el header con un color claro para contraste */

      /* Puedes usar el color secundario en enlaces o botones si quieres */
      a {
        font-family: "FuturaRoundDemi", sans-serif;
        color: var(--color-secundario);
        text-decoration: none;
      }

      /* Definición de fuentes */
      /* 1) Futura Round Regular */
      @font-face {
        font-family: "FuturaRound";
        src: url("/fonts/FuturaRound.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* 2) Futura Round Demi */
      @font-face {
        font-family: "FuturaRoundDemi";
        src: url("/fonts/FuturaRoundDemi.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* 3) Futura Book */
      @font-face {
        font-family: "FuturaBook";
        src: url("/fonts/FuturaBook.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* 4) Futura Bold */
      @font-face {
        font-family: "FuturaBold";
        src: url("/fonts/FuturaBold.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* Responsivo */
      @media (max-width: 768px) {
        main {
          padding: 1.5rem;
        }
      }
      @media (max-width: 480px) {
        main {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
