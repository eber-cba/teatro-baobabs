---
import logo from "../assets/logo.svg";
let isMenuOpen = false;
---

<div class="header">
  <div class="logo-container">
    <div class="text-container">
      <h1>BAOBABS</h1>
      <div class="separator"></div>
      <p class="subtitle">CLUB DE TEATRO</p>
    </div>
    <img src={logo.src} alt="logo" class="logo" />
  </div>
  <nav>
    <ul class={isMenuOpen ? "open" : ""}>
      <li><a href="/">Inicio</a></li>
      <li><a href="/talleres">Talleres</a></li>
      <li><a href="/galeria">Galería</a></li>
      <li><a href="/viajes">Viajes</a></li>
      <li><a href="/nosotros">Nosotros</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
    <div class="hamburger" id="menuButton">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>
  </nav>
</div>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    color: white;
    background-color: #493d9e;
    font-size: 1.3rem;
    overflow-x: hidden;
  }
  .logo-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .text-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    margin: 0;
    font-size: 3.6rem;
    font-family: "Coiny", serif;
    color: #f5f4fd;
  }
  .separator {
    width: 100%;
    height: 2px;
    background-color: #f5f4fd;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    margin: 0;
    font-size: 1.2rem;
    color: #f5f4fd;
    text-align: center;
  }
  .logo {
    height: 6rem; /* Ajusta el alto del logo para que coincida con el texto */
    width: auto;
  }
  nav {
    position: relative;
  }
  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s ease;
  }
  nav a:hover {
    color: #e74c3c;
  }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    cursor: pointer;
  }
  .hamburger .bar {
    width: 25px;
    height: 3px;
    background-color: white;
    transition: all 0.3s ease;
  }
  /* Tablet */
  @media (max-width: 768px) {
    nav ul {
      gap: 1rem;
    }
  }
  /* Mobile */
  @media (max-width: 480px) {
    .hamburger {
      display: flex;
    }
    nav ul {
      display: $ {
        ismenuopen?"flex": "none";
      }
      flex-direction: column;
      position: absolute;
      top: 100%;
      right: 0;
      background-color: #333;
      width: 100%;
      padding: 1rem;
      gap: 1rem;
    }
    nav a {
      font-size: 1rem;
    }
  }
</style>

<script>
  let isMenuOpen = false;
  const menuButton = document.getElementById("menuButton");
  if (menuButton) {
    menuButton.addEventListener("click", toggleMenu);
  }
  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    const navUl = document.querySelector("nav ul");
    if (navUl) {
      navUl.classList.toggle("open", isMenuOpen);
    }
  }
</script>
