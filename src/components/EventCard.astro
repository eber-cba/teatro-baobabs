---
interface Props {
  id: string;
  title: string;
  date: string;
  time: string;
  location: string;
  address: string;
  price: string;
  description: string;
  image: string;
}

const { id, title, date, time, location, address, price, description, image } =
  Astro.props;
---

<div class="event-card" data-event-id={id}>
  <div class="image-container">
    <img src={image} alt={title} />
    <div class="date-badge">
      <span class="day">{new Date(date).getDate()}</span>
      <span class="month"
        >{new Date(date).toLocaleString("es-ES", { month: "short" })}</span
      >
    </div>
  </div>
  <div class="content">
    <h3>{title}</h3>
    <div class="details">
      <div class="detail-item">
        <i class="fas fa-clock"></i>
        <span>{time}</span>
      </div>
      <div class="detail-item">
        <i class="fas fa-map-marker-alt"></i>
        <span>{location}</span>
      </div>
      <div class="detail-item">
        <i class="fas fa-ticket-alt"></i>
        <span>{price}</span>
      </div>
    </div>
    <p class="description">{description}</p>
    <a href={`/eventos/${id}`} class="btn-details">Ver más detalles</a>
  </div>
</div>

<style>
  .event-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .event-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .image-container {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .event-card:hover .image-container img {
    transform: scale(1.1);
  }

  .date-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(47, 185, 121, 0.9);
    color: white;
    padding: 10px;
    border-radius: 10px;
    text-align: center;
    min-width: 60px;
  }

  .date-badge .day {
    display: block;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .date-badge .month {
    display: block;
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  .content {
    padding: 20px;
  }

  .content h3 {
    margin: 0 0 15px 0;
    color: #2fb979;
    font-size: 1.4rem;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 15px;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.9rem;
    color: #666;
  }

  .detail-item i {
    color: #2fb979;
  }

  .description {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .btn-details {
    display: inline-block;
    padding: 10px 20px;
    background: #2fb979;
    color: white;
    text-decoration: none;
    border-radius: 25px;
    transition: background 0.3s ease;
    text-align: center;
    width: 100%;
  }

  .btn-details:hover {
    background: #248c5f;
  }

  @media (max-width: 768px) {
    .details {
      grid-template-columns: 1fr;
    }

    .content h3 {
      font-size: 1.2rem;
    }
  }
</style>

