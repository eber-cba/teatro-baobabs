---
const { open = false } = Astro.props;
---

<dialog id="modal" open={open}>
  <button id="closeModal" class="close-button">Cerrar</button>
  <div class="modal-content">
    <slot />
  </div>
  <style>
    dialog {
      border: none;
      border-radius: 8px;
      padding: 0;
      max-width: 90%;
      max-height: 90%;
      animation: zoomIn 0.5s ease;
    }
    dialog::backdrop {
      background: rgba(0, 0, 0, 0.7);
      animation: fadeIn 0.5s ease;
    }
    .close-button {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: var(--color-secundario);
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      cursor: pointer;
      border-radius: 4px;
      z-index: 10;
    }
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    @keyframes zoomIn {
      from {
        transform: scale(0.8);
      }
      to {
        transform: scale(1);
      }
    }
  </style>
  <script is:inline>
    const modal = document.getElementById("modal");
    const closeBtn = document.getElementById("closeModal");
    closeBtn.addEventListener("click", () => modal.close());
  </script>
</dialog>
