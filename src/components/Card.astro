---
const { item, onClick } = Astro.props;
---

<div class="card" onclick={onClick}>
  <div class="card-image">
    <img src={item.imagen} alt={item.titulo} />
  </div>
  <div class="card-content">
    <h3>{item.titulo}</h3>
    <p>{item.detalles}</p>
    <p><strong>Horario:</strong> {item.horario}</p>
    <p><strong>Cuota:</strong> {item.cuota}</p>
  </div>
</div>
<style>
  .card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 10px #e672ae;
    cursor: pointer;
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: row; /* Asegura que la tarjeta esté en una fila */
    width: 100%; /* Ajusta el ancho de la tarjeta */
    max-width: 1000px; /* Tamaño máximo para todas las tarjetas */
    align-items: center; /* Centra verticalmente el contenido */
  }
  .card-content h3 {
    font-family: "FuturaBold", sans-serif;
    font-size: 2rem;
    color: #2fb979;
  }
  .card:hover {
    transform: translateY(-5px);
  }
  .card-image {
    width: 40%; /* Ajusta el ancho de la imagen */
    height: auto; /* Ajusta la altura automáticamente */
    overflow: hidden;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Asegura que la imagen cubra todo el contenedor */
  }
  .card-content {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centra verticalmente el contenido */
  }
  .card-content > * {
    margin: 0.5rem 0; /* Reduce el espaciado entre los elementos */
  }
  .card-content p {
    font-family: "FuturaBook", sans-serif;
  }
  /* Responsivo */
  @media (max-width: 768px) {
    .card {
      flex-direction: column; /* Cambia a columna en pantallas pequeñas */
    }
    .card-image {
      width: 100%; /* Ajusta el ancho de la imagen */
      height: 200px; /* Tamaño fijo para todas las imágenes */
    }
    .card-content h3 {
      font-size: 1.1rem;
    }
  }
  @media (max-width: 480px) {
    .card-content h3 {
      font-size: 1rem;
    }
  }
</style>
